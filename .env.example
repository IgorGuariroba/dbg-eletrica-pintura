# ─── App ─────────────────────────────────────────────────────────────
# URL canônica do site (gera o link de aprovação /s/{token}). Em produção
# na Vercel há fallback automático para VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Banco (Neon Postgres) ───────────────────────────────────────────
DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require

# ─── Auth.js v5 ──────────────────────────────────────────────────────
# gerar: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth (console.cloud.google.com → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin Raiz — e-mail Google do Diego (case-insensitive)
ADMIN_EMAIL=

# ─── Cloudflare R2 ───────────────────────────────────────────────────
# Bucket público: fotos de serviço (catálogo) e técnicos (perfil)
# (Nota: ambos os buckets precisam de política de CORS habilitando PUT do origin local/produção)
R2_PUBLIC_ACCOUNT_ID=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=dbg-public
R2_PUBLIC_BASE_URL=https://pub-XXXX.r2.dev

# Bucket privado: fotos antes/depois de OS (acesso por URL assinada)
R2_PRIVATE_ACCOUNT_ID=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=dbg-private

# ─── E-mail (Resend) ──────────────────────────────────────────────────
# Chave de API da Resend (ex: re_123456789...)
RESEND_API_KEY=
# Remetente verificado de e-mail (ex: DBG Elétrica e Pintura <notificacoes@dbg.eletrica.br>)
RESEND_FROM_EMAIL=

# ─── DNS setup (scripts/resend-dns-setup.ts) ──────────────────────────
# Usadas só pelo script que cria os registros Resend na Cloudflare.
# Token "Edit zone DNS" da zona + Zone ID (painel da zona > Overview > API).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Domínio de envio (default: dbgservicos.eu.org)
RESEND_DOMINIO=

# ─── Pagamento (Mercado Pago) ─────────────────────────────────────────
# Access Token do MP. Sandbox usa prefixo TEST-; produção usa APP_USR-.
# Painel: mercadopago.com.br > Suas integrações > app > Credenciais.
# Rotacionar = gerar nova credencial no painel, trocar aqui e reimplantar.
MP_ACCESS_TOKEN=
# Segredo do webhook (Webhooks > Configurar notificações > Assinatura secreta).
# Usado para validar a assinatura HMAC-SHA256 das notificações de pagamento E
# de assinaturas (/api/webhooks/mercadopago e /api/webhooks/mp-subscriptions).
MP_WEBHOOK_SECRET=
# true em sandbox/homologação; false ou ausente em produção.
MP_SANDBOX=true
# Assinaturas (Subscriptions/pre-approval) reusam MP_ACCESS_TOKEN (mesma conta).
# Pré-requisitos manuais (ver PR da Fase 5/Slice 1):
#   1. Conta MP com Subscriptions (pre-approval) habilitado.
#   2. Webhook no painel apontando para /api/webhooks/mp-subscriptions,
#      eventos: subscription_preapproval e subscription_authorized_payment.

# ─── Upsell de assinatura (#65) ───────────────────────────────────────
# Dias até o upsell poder reaparecer a um cliente que já o viu (e não assinou).
# Ausente ou inválido → 90. Assinante ativo nunca vê, independente disto.
UPSELL_REEXIBICAO_DIAS=90

# ─── Cron (Vercel) ────────────────────────────────────────────────────
# Segredo do cron diário de geração de preventivas (/api/cron/preventivas).
# A Vercel o envia em `Authorization: Bearer ${CRON_SECRET}`. Sem ele a rota
# nega tudo (fail-closed). Defina o mesmo valor nas env vars do projeto Vercel.
CRON_SECRET=

# ─── WhatsApp Business Cloud API (Meta) ───────────────────────────────
# Notificações proativas com templates aprovados. Sem estas vars, o gateway
# roda em modo mock (loga e devolve message id falso) — dev e testes funcionam.
# Setup manual (Meta Business Manager / developers.facebook.com):
#   1. Migrar o número (11) 95236-0688 para WhatsApp Business verificado.
#   2. Criar app + produto WhatsApp; copiar Phone Number ID e WABA ID.
#   3. Aprovar os templates (pt_BR): orcamento_pronto, tecnico_a_caminho,
#      lembrete_pagamento, pedido_avaliacao, garantia_acionada.
#   4. Configurar o webhook apontando para /api/webhooks/whatsapp com o
#      Verify Token abaixo; assinar o campo "messages".
META_WABA_ID=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# App Secret (Configurações do app > Básico) — valida X-Hub-Signature-256.
META_APP_SECRET=
# Token arbitrário definido por nós e repetido no painel da Meta no setup.
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp do admin (E.164 sem +) que recebe o alerta de emergência Premium.
META_ADMIN_WHATSAPP=

# --- Cloudflare Turnstile (captcha do /solicitar) ---
# Sem as chaves o captcha fica desligado (dev/test). Criar em
# https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
