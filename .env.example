# ─── App ─────────────────────────────────────────────────────────────
# URL canônica do site (gera o link de aprovação /s/{token}). Em produção
# na Vercel há fallback automático para VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Banco (Neon Postgres) ───────────────────────────────────────────
DATABASE_URL=postgres://USER:PASS@HOST/neondb?sslmode=require

# ─── Auth.js v5 ──────────────────────────────────────────────────────
# gerar: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Google OAuth (console.cloud.google.com → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Admin Raiz — e-mail Google do Diego (case-insensitive)
ADMIN_EMAIL=

# ─── Cloudflare R2 ───────────────────────────────────────────────────
# Bucket público: fotos de serviço (catálogo) e técnicos (perfil)
# (Nota: ambos os buckets precisam de política de CORS habilitando PUT do origin local/produção)
R2_PUBLIC_ACCOUNT_ID=
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=dbg-public
R2_PUBLIC_BASE_URL=https://pub-XXXX.r2.dev

# Bucket privado: fotos antes/depois de OS (acesso por URL assinada)
R2_PRIVATE_ACCOUNT_ID=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=dbg-private

# ─── E-mail (Resend) ──────────────────────────────────────────────────
# Chave de API da Resend (ex: re_123456789...)
RESEND_API_KEY=
# Remetente verificado de e-mail (ex: DBG Elétrica e Pintura <notificacoes@dbg.eletrica.br>)
RESEND_FROM_EMAIL=

# ─── DNS setup (scripts/resend-dns-setup.ts) ──────────────────────────
# Usadas só pelo script que cria os registros Resend na Cloudflare.
# Token "Edit zone DNS" da zona + Zone ID (painel da zona > Overview > API).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Domínio de envio (default: dbgservicos.eu.org)
RESEND_DOMINIO=
